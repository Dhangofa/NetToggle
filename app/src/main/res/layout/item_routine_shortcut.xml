<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:background="@drawable/shape_cycle_segmented_container_rect"
    android:padding="4dp">

    <TextView
        android:id="@+id/slotLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_1"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"/>

    <Spinner
        android:id="@+id/spinnerSim"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="40dp" />

    <Spinner
        android:id="@+id/spinnerMode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:minHeight="40dp" />

    <ImageView
        android:id="@+id/btnRemoveShortcut"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@color/status_error_text"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_marginEnd="4dp"
        android:contentDescription="Remove shortcut" />
</LinearLayout>
