<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/section_outline_bg"
    android:padding="12dp"
    android:layout_marginBottom="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_refresh"
                android:tint="@color/brand_primary"
                android:layout_marginEnd="6dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Tile Cycle"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="3/3"
            android:background="@drawable/shape_pill_badge_bg"
            android:textColor="@color/brand_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </RelativeLayout>

    <!-- 2x2 Grid for Cycle Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✓ 5G Only"
                android:padding="10dp"
                android:background="@drawable/shape_radio_item_bg"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"/>
                
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✓ Preferred 5G"
                android:padding="10dp"
                android:background="@drawable/shape_radio_item_bg"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✓ 4G Only"
                android:padding="10dp"
                android:background="@drawable/shape_radio_item_bg"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"/>
                
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="○ Preferred 4G"
                android:padding="10dp"
                android:background="@drawable/shape_segmented_container"
                android:textColor="#808080"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Sequence Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/shape_segmented_container"
        android:padding="8dp"
        android:layout_marginTop="12dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5G Only"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" → "
            android:textColor="#808080"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="4dp" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4G Only"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" → "
            android:textColor="#808080"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="4dp" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preferred 5G"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
