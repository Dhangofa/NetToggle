<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_exec_card_bg"
    android:elevation="8dp"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        
        <LinearLayout
            android:id="@+id/execModeTitleGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_shield"
                android:tint="@color/exec_accent"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/execution_mode"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/execModeTitleGroup"
            android:gravity="end|center_vertical">
            
            <TextView
                android:id="@+id/shizukuStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/authorized"
                android:background="@drawable/shape_status_badge_success"
                android:textColor="@color/status_success_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Segmented Control for Execution Mode -->
    <RadioGroup
        android:id="@+id/modeRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/shape_exec_segmented_container"
        android:padding="4dp">
        
        <RadioButton
            android:id="@+id/radioRoot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/root"
            android:button="@null"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingVertical="8dp"
            android:background="@drawable/selector_segmented_tab_exec"
            android:textColor="@color/color_segmented_text_exec"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View 
            android:id="@+id/separatorRootShizuku"
            android:layout_width="1dp" 
            android:layout_height="match_parent" 
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/exec_segmented_separator" />

        <RadioButton
            android:id="@+id/radioShizuku"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/shizuku"
            android:button="@null"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingVertical="8dp"
            android:background="@drawable/selector_segmented_tab_exec"
            android:textColor="@color/color_segmented_text_exec"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RadioGroup>

</LinearLayout>
