<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mainRoot"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <!-- Main Content Area -->
    <FrameLayout
        android:id="@+id/mainContentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true">

        <include layout="@layout/layout_tab_home" />
        <include layout="@layout/layout_tab_automation" />
        <include layout="@layout/layout_tab_guides" />

    </FrameLayout>

    <!-- Top App Bar (Overlays Main Content and slides up) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/card_surface"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/shape_app_icon_bg"
            android:layout_marginEnd="12dp">
            <ImageView
                android:contentDescription="@null"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_logo"
                android:tint="@color/brand_on_primary_container" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title_net_toggle"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_desc_advanced"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnThemeToggle"
            android:contentDescription="@string/change_theme"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_theme_light"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Floating Pill Bottom Navigation -->
    <FrameLayout
        android:id="@+id/bottomNavPill"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_pill_nav"
        android:elevation="12dp"
        android:paddingHorizontal="8dp">

        <!-- Synchronized Sliding Indicator Pill -->
        <View
            android:id="@+id/navIndicatorPill"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_nav_item_selected" />

        <LinearLayout
            android:id="@+id/navItemsRow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:contentDescription="@null"
                    android:id="@+id/iconNavHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_setup_filled"
                    android:tint="@color/nav_item_selected_content" />
                <TextView
                    android:id="@+id/textNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/nav_home"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="none"
                    android:visibility="visible"
                    android:textColor="@color/nav_item_selected_content"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navAutomation"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:contentDescription="@null"
                    android:id="@+id/iconNavAutomation"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_automate_outline"
                    android:tint="@color/nav_item_unselected_icon" />
                <TextView
                    android:id="@+id/textNavAutomation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/nav_automate"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="none"
                    android:visibility="gone"
                    android:textColor="@color/nav_item_unselected_icon"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navGuides"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:contentDescription="@null"
                    android:id="@+id/iconNavGuides"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_guides_outline"
                    android:tint="@color/nav_item_unselected_icon" />
                <TextView
                    android:id="@+id/textNavGuides"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/nav_guides"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="none"
                    android:visibility="gone"
                    android:textColor="@color/nav_item_unselected_icon"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Wavy Floating Action Button for Add Shortcut (Beside Nav Bar right side in portrait) -->
    <FrameLayout
        android:id="@+id/btnAddShortcut"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_toEndOf="@id/bottomNavPill"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/shape_fab_wavy"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iconAddShortcut"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_add"
            android:tint="@color/fab_add_shortcut_icon"
            android:contentDescription="@string/add_shortcut" />
    </FrameLayout>
</RelativeLayout>
