<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:fitsSystemWindows="true"
    android:background="@color/surface_background">

    <!-- Edge Navigation Rail Container (Floating Pill shape matching portrait mode) -->
    <FrameLayout
        android:id="@+id/edgeBarContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_edge_nav"
        android:elevation="12dp"
        android:paddingVertical="8dp"
        android:paddingHorizontal="4dp">

        <FrameLayout
            android:id="@+id/edgeNavItemsContainer"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <!-- Sliding Active Indicator Pill -->
            <View
                android:id="@+id/navIndicatorPill"
                android:layout_width="56dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_nav_item_selected" />

            <!-- Vertical Navigation Column -->
            <LinearLayout
                android:id="@+id/edgeNavTabsColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Tab 0: Home -->
                <LinearLayout
                    android:id="@+id/navHome"
                    android:layout_width="56dp"
                    android:layout_height="64dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconNavHome"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_home_filled"
                        android:tint="@color/nav_item_selected_content"
                        android:contentDescription="@string/nav_tab_home" />

                    <TextView
                        android:id="@+id/textNavHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/nav_tab_home"
                        android:textColor="@color/nav_item_selected_content"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Tab 1: Automate -->
                <LinearLayout
                    android:id="@+id/navAutomation"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconNavAutomation"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_automate_outline"
                        android:tint="@color/nav_item_unselected_icon"
                        android:contentDescription="@string/nav_tab_automate" />

                    <TextView
                        android:id="@+id/textNavAutomation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/nav_tab_automate"
                        android:textColor="@color/nav_item_unselected_icon"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:gravity="center"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Tab 2: Guides -->
                <LinearLayout
                    android:id="@+id/navGuides"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconNavGuides"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_guides_outline"
                        android:tint="@color/nav_item_unselected_icon"
                        android:contentDescription="@string/nav_tab_guides" />

                    <TextView
                        android:id="@+id/textNavGuides"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/nav_tab_guides"
                        android:textColor="@color/nav_item_unselected_icon"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:gravity="center"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Main Content Area Wrapper -->
    <LinearLayout
        android:id="@+id/mainContentWrapper"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Main Content Area -->
        <FrameLayout
            android:id="@+id/mainContentFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include layout="@layout/layout_tab_home" />
            <include layout="@layout/layout_tab_automation" />
            <include layout="@layout/layout_tab_guides" />

        </FrameLayout>
    </LinearLayout>

</LinearLayout>
